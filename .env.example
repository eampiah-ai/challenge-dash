# Database connection string (PostgreSQL)
# For local development with Docker:
#   docker run --name challenge-dash-db -e POSTGRES_USER=challenge -e POSTGRES_PASSWORD=challenge -e POSTGRES_DB=challenge -p 5434:5432 -d postgres:16
DATABASE_URL="postgresql://challenge:challenge@localhost:5434/challenge"

# Secret used to encrypt session cookies (generate a strong random string in production)
SESSION_SECRET="change-me-to-a-32-character-minimum-secret"

# Plaintext shared group password used to seed the challenge
# After seeding, the bcrypt hash is stored in the database and this value is no longer required
GROUP_PASSWORD="your-shared-group-password"
